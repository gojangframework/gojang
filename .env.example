# Database (SQLite for dev, Postgres for prod)
DATABASE_URL=sqlite://./dev.db
# DATABASE_URL=postgres://user:pass@localhost:5432/gojang?sslmode=disable

# Session secret (generate with: openssl rand -base64 32)
# IMPORTANT: Generate a secure random key for production!
SESSION_KEY=

# App config
DEBUG=true
DEVHOST=0.0.0.0
PORT=8080
ALLOWED_HOSTS=localhost,127.0.0.1
APP_BASE_URL=http://localhost:8080

# Content Security Policy (comma-separated directive values; leave blank for defaults)
# CSP_SCRIPT_SRC='self','unsafe-inline',https://unpkg.com
# CSP_CONNECT_SRC='self'
# CSP_SAME_ORIGIN_FRAME_PATHS=/embed/

# Email delivery. Amazon SES is preferred when fully configured; SMTP is used as fallback.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
FROM_EMAIL_ADDRESS=noreply@gojang.local
FROM_DISPLAY_NAME=Gojang

# SMTP fallback
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@gojang.local
SMTP_FROM_NAME=Gojang
EMAIL_SEND_RATE=14
EMAIL_QUEUE_SIZE=1000
EMAIL_WORKER_COUNT=14
EMAIL_SEND_TIMEOUT=15s
